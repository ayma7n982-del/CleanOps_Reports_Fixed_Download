<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 11 and below: match the first Flutter frame. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#F8FCFA"
                android:centerColor="#EBF8F2"
                android:endColor="#D9F0E6" />
        </shape>
    </item>
    <item android:gravity="center" android:width="268dp" android:height="268dp">
        <shape android:shape="oval">
            <solid android:color="#DDF5E9" />
            <stroke android:width="2dp" android:color="#BDE9D8" />
        </shape>
    </item>
    <item android:gravity="center" android:width="208dp" android:height="208dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <stroke android:width="1dp" android:color="#DBEFE4" />
        </shape>
    </item>
    <!-- Same launcher asset regenerated from assets/brand/cleanops_logo_new.png. -->
    <item
        android:drawable="@mipmap/ic_launcher"
        android:gravity="center"
        android:width="136dp"
        android:height="136dp" />
</layer-list>
