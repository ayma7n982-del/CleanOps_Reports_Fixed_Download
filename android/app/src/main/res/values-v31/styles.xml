<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: explicitly brand the OS-managed splash screen.
         Without these attrs Samsung/Android may show the default white icon
         screen before Flutter starts. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#E8F7EF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/cleanops_splash_clear</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#E8F7EF</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">#E8F7EF</item>
        <item name="android:navigationBarColor">#E8F7EF</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">#F8FCFA</item>
    </style>
</resources>
